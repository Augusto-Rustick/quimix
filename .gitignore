# ===== Unity =====
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/MemoryCaptures/

# Asset meta files should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Unity auto-generated VS/Rider solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated meta files
*.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.app
*.unitypackage
ExportedObj/

# Crashlytics
crashlytics-build.properties

# Streaming assets temp files
~UnityDirMonSyncFile~*
**/Assets/AddressableAssetsData/*/*.bin*
**/Assets/StreamingAssets/aa.meta
**/Assets/StreamingAssets/aa/*

# ===== IDE =====
.vs/
.vscode/
.idea/
.gradle/
.consulo/

# macOS / Windows
.DS_Store*
Thumbs.db
Desktop.ini

# ===== Plastic SCM =====
.plastic/

# ===== Claude Code =====
.claude/
CLAUDE.md

# ===== Arquivos locais (não versionados) =====
local/*
!local/.gitkeep
